#!/bin/bash
# Put pastes arriving in CrossPaste onto the Wayland clipboard directly, instead
# of relying on Hyprland's XWayland bridge (CrossPaste only writes the X11
# clipboard):
#   - image/file pastes (synced or local): the local file path(s) as plain
#     text, because the bridge exposes them to Wayland apps as an empty text
#     entry, so pasting in a terminal would insert nothing.
#   - text/link/html/rtf/color pastes synced from another device: their plain
#     text, because the bridge sometimes drops or lags these. For html/rtf
#     that is the plain text the sender copied alongside the markup (e.g. the
#     URL when a link is copied in a browser), falling back to the summary.
#
# Writes go through crosspaste-wl-copy rather than wl-copy: it marks the
# selection with CrossPaste's origin MIME type, so CrossPaste does not capture
# the text as a new local paste and sync it back to the device it came from.
#
# Runs as the crosspaste-path-sync systemd user service and reconnects if
# CrossPaste is not running yet or restarts.

CLI=/opt/crosspaste/lib/app/bin/crosspaste-cli
COPY=${0%/*}/crosspaste-wl-copy
DB=$HOME/.local/share/.crosspaste/data/crosspaste.db

shell_join() {
  # Join paths with spaces; single-quote any that contain whitespace so the
  # result pastes into a shell as-is. No trailing newline.
  local out="" p
  while IFS= read -r p; do
    [[ -z $p ]] && continue
    [[ $p =~ [[:space:]] ]] && p="'${p//\'/\'\\\'\'}'"
    out+="${out:+ }$p"
  done
  printf '%s' "$out"
}

plain_text_item() {
  # The text item stored next to a paste's primary (html/rtf) item. The CLI only
  # prints the primary item, so read it from CrossPaste's database.
  [[ -r $DB ]] || return
  sqlite3 -readonly "$DB" "SELECT pasteCollection FROM PasteDataEntity WHERE id = $1" 2>/dev/null |
    jq -r '[.[] | fromjson | select(.type == 0) | .text][0] // empty' 2>/dev/null
}

trim() {
  # Strip leading/trailing whitespace; HTML summaries carry markup indentation.
  local s=$1
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

handle() {
  local id=$1 json type remote paths text
  json=$("$CLI" --no-start --json paste "$id" 2>/dev/null) || return
  type=$(jq -r '.typeName' <<<"$json")
  remote=$(jq -r '.remote' <<<"$json")

  case $type in
    image | file)
      paths=$(jq -r '(.filePaths // [])[]' <<<"$json")
      [[ -z $paths ]] && return
      text=$(shell_join <<<"$paths")
      ;;
    text | link | color)
      [[ $remote == true ]] || return
      text=$("$CLI" --no-start paste --raw --no-newline "$id" 2>/dev/null) || return
      ;;
    html | rtf)
      [[ $remote == true ]] || return
      text=$(plain_text_item "$id")
      [[ -n $text ]] || text=$(trim "$("$CLI" --no-start paste --summary --no-newline "$id" 2>/dev/null)") || return
      ;;
    *) return ;;
  esac
  [[ -z $text ]] && return

  # Leave the clipboard alone if the bridge already delivered the same text.
  if [[ $(trim "$(timeout 2 wl-paste -n -t text 2>/dev/null)") == "$(trim "$text")" ]]; then
    echo "paste #$id ($type) already on clipboard: ${text:0:120}"
    return
  fi

  printf '%s' "$text" | "$COPY"
  echo "paste #$id ($type) -> clipboard: ${text:0:120}"
}

while true; do
  if "$CLI" --no-start status >/dev/null 2>&1; then
    "$CLI" --no-start watch --format id 2>/dev/null |
      while IFS= read -r id; do
        [[ $id =~ ^[0-9]+$ ]] && handle "$id"
      done
  fi
  sleep 5
done
